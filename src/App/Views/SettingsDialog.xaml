<Window x:Class="HyperPDF.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:HyperPDF.Models"
        Title="Settings"
        Width="620"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" Style="{StaticResource HeadingTextStyle}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Appearance" Style="{StaticResource HeadingTextStyle}" FontSize="14" />
                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Theme" Style="{StaticResource BaseTextStyle}" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <RadioButton x:Name="LightThemeButton"
                                         GroupName="Theme"
                                         Content="Light"
                                         Margin="0,0,16,0"
                                         Checked="OnLightThemeChecked" />
                            <RadioButton x:Name="DarkThemeButton"
                                         GroupName="Theme"
                                         Content="Dark"
                                         Checked="OnDarkThemeChecked" />
                        </StackPanel>

                        <TextBlock Text="Page layout" Style="{StaticResource BaseTextStyle}" FontWeight="SemiBold" Margin="0,14,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <RadioButton x:Name="ContinuousButton"
                                         GroupName="Layout"
                                         Content="Continuous"
                                         Margin="0,0,16,0"
                                         Checked="OnContinuousChecked" />
                            <RadioButton x:Name="SinglePageButton"
                                         GroupName="Layout"
                                         Content="Single page"
                                         Checked="OnSinglePageChecked" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Reading" Style="{StaticResource HeadingTextStyle}" FontSize="14" Margin="0,18,0,0" />
                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                    <StackPanel>
                        <CheckBox x:Name="RestorePositionCheckBox"
                                  Content="Restore the last reading position of a document"
                                  Checked="OnRestorePositionChanged"
                                  Unchecked="OnRestorePositionChanged" />
                        <CheckBox x:Name="ThumbnailsCheckBox"
                                  Content="Show the thumbnail sidebar"
                                  Margin="0,10,0,0"
                                  Checked="OnThumbnailsChanged"
                                  Unchecked="OnThumbnailsChanged" />
                        <CheckBox x:Name="StatusBarCheckBox"
                                  Content="Show the status bar"
                                  Margin="0,10,0,0"
                                  Checked="OnStatusBarChanged"
                                  Unchecked="OnStatusBarChanged" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Recent documents" Style="{StaticResource HeadingTextStyle}" FontSize="14" Margin="0,18,0,0" />
                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="RecentListBox"
                                 Grid.Row="0"
                                 MaxHeight="160"
                                 Style="{StaticResource ThumbnailListStyle}"
                                 ItemContainerStyle="{StaticResource ThumbnailListItemStyle}"
                                 ItemsSource="{Binding RecentFiles}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="520" Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FileName}" Style="{StaticResource BaseTextStyle}" />
                                            <TextBlock Text="{Binding FilePath}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource IconButtonStyle}"
                                                Tag="{Binding}"
                                                Click="OnRemoveRecentClick"
                                                ToolTip="Remove from the list">
                                            <Path Data="{StaticResource IconClose}" Style="{StaticResource ToolbarIconStyle}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Grid.Row="1"
                                Content="Clear the list"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="8"
                                Command="{Binding ClearRecentCommand}" />
                    </Grid>
                </Border>

                <TextBlock Text="Default application" Style="{StaticResource HeadingTextStyle}" FontSize="14" Margin="0,18,0,0" />
                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding DefaultAppDescription}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        <Button Content="Open the Windows default app settings"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Command="{Binding OpenDefaultAppsCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Close"
                Style="{StaticResource SecondaryButtonStyle}"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                IsCancel="True"
                IsDefault="True"
                Click="OnCloseClick" />
    </Grid>
</Window>
