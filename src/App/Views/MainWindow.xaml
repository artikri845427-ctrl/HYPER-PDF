<Window x:Class="HyperPDF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:HyperPDF"
        xmlns:views="clr-namespace:HyperPDF.Views"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/HyperPDF.ico"
        Width="1240"
        Height="820"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FindCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseCurrentDocumentCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextTabCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding PreviousTabCommand}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ZoomResetCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="F11" Command="{Binding ToggleFullScreenCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleSidebarCommand}" />
    </Window.InputBindings>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" x:Name="TitleBarRow" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" x:Name="StatusBarRow" />
        </Grid.RowDefinitions>

        <!-- ============================ Title bar ============================ -->
        <Border Grid.Row="0"
                x:Name="TitleBar"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid Height="38">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource AccentBrush}">
                        <Path Data="{StaticResource IconLogo}"
                              Width="13"
                              Height="13"
                              Stroke="{DynamicResource AccentForegroundBrush}"
                              StrokeThickness="1.6"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="{x:Static local:BrandInfo.ApplicationName}"
                               Style="{StaticResource BaseTextStyle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding WindowTitle}"
                           Style="{StaticResource SecondaryTextStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="12,0"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="Switch between the light and the dark theme">
                        <Path Data="{StaticResource IconTheme}" Style="{StaticResource ToolbarIconStyle}" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ShowSettingsCommand}"
                            ToolTip="Settings">
                        <Path Data="{StaticResource IconSettings}" Style="{StaticResource ToolbarIconStyle}" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ShowAboutCommand}"
                            ToolTip="About HyperPDF">
                        <Path Data="{StaticResource IconInfo}" Style="{StaticResource ToolbarIconStyle}" />
                    </Button>

                    <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="6,8,6,0" />

                    <Button Style="{StaticResource WindowButtonStyle}"
                            Click="OnMinimizeClick"
                            ToolTip="Minimise">
                        <Path Data="{StaticResource IconWindowMinimize}"
                              Width="10"
                              Height="10"
                              Stretch="Uniform"
                              Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="1.2" />
                    </Button>
                    <Button Style="{StaticResource WindowButtonStyle}"
                            Click="OnMaximizeClick"
                            ToolTip="Maximise">
                        <Path x:Name="MaximizeGlyph"
                              Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Data="{StaticResource IconWindowMaximize}"
                              Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="1.2" />
                    </Button>
                    <Button Style="{StaticResource WindowCloseButtonStyle}"
                            Click="OnCloseClick"
                            ToolTip="Close">
                        <Path Data="{StaticResource IconClose}"
                              Width="10"
                              Height="10"
                              Stretch="Uniform"
                              Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="1.2" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Toolbar ============================== -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="8,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenCommand}" ToolTip="Open a PDF file (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconOpen}" Style="{StaticResource ToolbarIconStyle}" />
                            <TextBlock Text="Open" Style="{StaticResource BaseTextStyle}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding FirstPageCommand}"
                            CommandParameter="{Binding SelectedDocument}"
                            ToolTip="First page">
                        <Path Data="{StaticResource IconFirstPage}" Style="{StaticResource ToolbarIconStyle}" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding PreviousPageCommand}"
                            CommandParameter="{Binding SelectedDocument}"
                            ToolTip="Previous page">
                        <Path Data="{StaticResource IconPreviousPage}" Style="{StaticResource ToolbarIconStyle}" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding NextPageCommand}"
                            CommandParameter="{Binding SelectedDocument}"
                            ToolTip="Next page">
                        <Path Data="{StaticResource IconNextPage}" Style="{StaticResource ToolbarIconStyle}" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding LastPageCommand}"
                            CommandParameter="{Binding SelectedDocument}"
                            ToolTip="Last page">
                        <Path Data="{StaticResource IconLastPage}" Style="{StaticResource ToolbarIconStyle}" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ZoomOutCommand}"
                            ToolTip="Zoom out (Ctrl+-)">
                        <Path Data="{StaticResource IconZoomOut}" Style="{StaticResource ToolbarIconStyle}" />
                    </Button>
                    <TextBlock Text="{Binding SelectedDocument.ZoomText}"
                               Style="{StaticResource BaseTextStyle}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               MinWidth="52"
                               Margin="2,0" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ZoomInCommand}"
                            ToolTip="Zoom in (Ctrl++)">
                        <Path Data="{StaticResource IconZoomIn}" Style="{StaticResource ToolbarIconStyle}" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding FitPageCommand}"
                            ToolTip="Fit the page into the window">
                        <Path Data="{StaticResource IconFitPage}" Style="{StaticResource ToolbarIconStyle}" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding FitWidthCommand}"
                            ToolTip="Fit the page width into the window">
                        <Path Data="{StaticResource IconFitWidth}" Style="{StaticResource ToolbarIconStyle}" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding RotateCounterClockwiseCommand}"
                            CommandParameter="{Binding SelectedDocument}"
                            ToolTip="Rotate counter clockwise">
                        <Path Data="{StaticResource IconRotateLeft}" Style="{StaticResource ToolbarIconStyle}" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding RotateClockwiseCommand}"
                            CommandParameter="{Binding SelectedDocument}"
                            ToolTip="Rotate clockwise">
                        <Path Data="{StaticResource IconRotateRight}" Style="{StaticResource ToolbarIconStyle}" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="Show or hide the thumbnail sidebar (Ctrl+B)">
                        <Path Data="{StaticResource IconSidebar}" Style="{StaticResource ToolbarIconStyle}" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding FindCommand}"
                            ToolTip="Find text (Ctrl+F)">
                        <Path Data="{StaticResource IconSearch}" Style="{StaticResource ToolbarIconStyle}" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ToggleFullScreenCommand}"
                            ToolTip="Full screen (F11)">
                        <Path Data="{StaticResource IconFullScreen}" Style="{StaticResource ToolbarIconStyle}" />
                    </Button>
                    <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="6,0" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding PrintCommand}"
                            ToolTip="Print the document (Ctrl+P)">
                        <Path Data="{StaticResource IconPrint}" Style="{StaticResource ToolbarIconStyle}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Tab strip ============================ -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding IsWelcomeVisible, Converter={StaticResource InverseBoolToVisibility}}">
            <TabControl x:Name="DocumentTabs"
                        Style="{StaticResource DocumentTabControlStyle}"
                        ItemsSource="{Binding Documents}"
                        SelectedItem="{Binding SelectedDocument, Mode=TwoWay}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource BaseTextStyle}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Width="22"
                                    Height="22"
                                    Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Close the document">
                                <Path Data="{StaticResource IconClose}" Style="{StaticResource ToolbarIconStyle}" Width="12" Height="12" />
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
        </Border>

        <!-- ============================== Content ============================ -->
        <Grid Grid.Row="3">
            <!-- Welcome screen -->
            <Grid Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="560"
                                Margin="24">
                        <Border Width="84" Height="84" CornerRadius="20" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconLogo}"
                                  Width="46"
                                  Height="46"
                                  Stroke="{DynamicResource AccentForegroundBrush}"
                                  StrokeThickness="1.4"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform" />
                        </Border>

                        <TextBlock Text="{Binding WelcomeTitle}"
                                   Style="{StaticResource TitleTextStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0" />

                        <TextBlock Text="{Binding WelcomeSubtitle}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />

                        <Button Content="Open a PDF file"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,22,0,0"
                                Command="{Binding OpenCommand}" />

                        <Border Style="{StaticResource CardStyle}" Margin="0,28,0,0"
                                Visibility="{Binding HasNoRecentFiles, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Recent documents" Style="{StaticResource HeadingTextStyle}" FontSize="14" />
                                <ItemsControl ItemsSource="{Binding RecentFiles}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconDocument}" Style="{StaticResource ToolbarIconStyle}" VerticalAlignment="Center" />
                                                    <StackPanel Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource BaseTextStyle}" />
                                                        <TextBlock Text="{Binding FilePath}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" ToolTip="Open" Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconOpen}" Style="{StaticResource ToolbarIconStyle}" />
                                                </Button>
                                                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" ToolTip="Show in Explorer" Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconFolder}" Style="{StaticResource ToolbarIconStyle}" />
                                                </Button>
                                                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" ToolTip="Remove" Command="{Binding DataContext.RemoveRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconClose}" Style="{StaticResource ToolbarIconStyle}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding Attribution}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,24,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Open documents -->
            <views:DocumentView x:Name="DocumentView"
                                Visibility="{Binding IsWelcomeVisible, Converter={StaticResource InverseBoolToVisibility}}"
                                DataContext="{Binding SelectedDocument}" />
        </Grid>

        <!-- ============================ Status bar ========================== -->
        <Border Grid.Row="4"
                x:Name="StatusBar"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{Binding ShowStatusBar, Converter={StaticResource BoolToVisibility}, FallbackValue=Visible}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource CaptionTextStyle}"
                           VerticalAlignment="Center"
                           Text="{Binding SelectedDocument.CurrentPageNumber, StringFormat='Page {0}'}" />

                <TextBlock Grid.Column="1"
                           Style="{StaticResource CaptionTextStyle}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Text="{Binding SelectedDocument.PageCount, StringFormat='of {0} pages'}" />

                <TextBlock Grid.Column="2"
                           Style="{StaticResource CaptionTextStyle}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           Text="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedDocument.ZoomText}"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Text=" · "
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{x:Static local:BrandInfo.CreditLine}"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
