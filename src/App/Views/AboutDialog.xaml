<Window x:Class="HyperPDF.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HyperPDF"
        Title="{x:Static local:BrandInfo.ApplicationName}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        ShowInTaskbar="False">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="64" Height="64" CornerRadius="14" Background="{DynamicResource AccentBrush}">
                <Path Data="{StaticResource IconLogo}"
                      Width="34"
                      Height="34"
                      Stroke="{DynamicResource AccentForegroundBrush}"
                      StrokeThickness="1.4"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Stretch="Uniform" />
            </Border>

            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static local:BrandInfo.ApplicationName}"
                           Style="{StaticResource HeadingTextStyle}" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0">
                    <Run Text="Version" />
                    <Run Text="{x:Static local:BrandInfo.ApplicationVersion}" />
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="{x:Static local:BrandInfo.Description}"
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Developer" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static local:BrandInfo.DeveloperName}" Style="{StaticResource BaseTextStyle}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Handle" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static local:BrandInfo.DeveloperHandle}" Style="{StaticResource BaseTextStyle}" Margin="0,6,0,0" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Contact" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Static local:BrandInfo.ContactNumber}" Style="{StaticResource BaseTextStyle}" Margin="0,6,0,0" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="PDF engine" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,0,0">
                        <Run Text="PDFium" />
                        <Run Text="{x:Static local:BrandInfo.PdfiumVersion}" />
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource CaptionTextStyle}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Text="{x:Static local:BrandInfo.CreditLine}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Check for updates"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnCheckUpdatesClick"
                        Margin="0,0,8,0" />
                <Button Content="Close"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"
                        IsDefault="True"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
