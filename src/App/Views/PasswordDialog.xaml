<Window x:Class="HyperPDF.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password required"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Path Data="{StaticResource IconWarning}"
                  Style="{StaticResource ToolbarIconStyle}"
                  Stroke="{DynamicResource WarningBrush}"
                  Margin="0,0,10,0" />
            <TextBlock x:Name="MessageText"
                       Style="{StaticResource BaseTextStyle}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </StackPanel>

        <PasswordBox x:Name="PasswordBox"
                     Grid.Row="1"
                     Margin="0,16,0,0"
                     Padding="8,6"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="13"
                     Background="{DynamicResource SurfaceAltBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     BorderThickness="1"
                     KeyDown="OnPasswordKeyDown" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True"
                    Click="OnCancelClick"
                    Margin="0,0,8,0" />
            <Button Content="Open"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    Click="OnOkClick" />
        </StackPanel>
    </Grid>
</Window>
