;
; The exports of HyperPDFThumbnailProvider.dll. The module definition file keeps the
; exported names free of decorations on x86 and x64.

LIBRARY "HyperPDFThumbnailProvider"

EXPORTS
    DllGetClassObject   PRIVATE
    DllCanUnloadNow     PRIVATE
    DllRegisterServer   PRIVATE
    DllUnregisterServer PRIVATE
